# Prefer: agentmu login  (SuperGrok / X Premium+ OAuth — no key needed)
# Or set an API key (https://console.x.ai):
# XAI_API_KEY=xai-your-key-here

# Optional overrides
# AGENTMU_LABEL=Artifact
# AGENTMU_MODEL=grok-4.5
# AGENTMU_BASE_URL=https://api.x.ai/v1
# AGENTMU_IMAGE_MODEL=grok-2-image

# Optional richer web search (otherwise Wikipedia OpenSearch is used free)
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Optional X (Twitter) recent search
# X_BEARER_TOKEN=
